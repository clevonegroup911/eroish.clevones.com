# Names only. Never put a real secret in this file.

# SQLite for local / CI / tests (default).
# Production on the Nginx VM should use PostgreSQL — see docs/DEPLOYMENT.md.
DATABASE_URL="file:./dev.db"

# HMAC secret for signed admin session tokens.
# Generate with: openssl rand -base64 48
# Minimum 32 characters. Never commit the real secret.
AUTH_SECRET="dev-only-auth-secret-change-before-production-use-32b"

# Canonical public origin. Required and must be https in production.
# Never derived from Host or X-Forwarded-* headers.
APP_ORIGIN="http://127.0.0.1:3000"

# Public site URL used by sitemap, robots, and metadata (not the local bind).
# Defaults to https://eroish.clevones.com when unset.
SITE_URL="https://eroish.clevones.com"

# Bootstrap admin (local / first deploy only). Change immediately.
ADMIN_BOOTSTRAP_EMAIL="admin@localhost"
ADMIN_BOOTSTRAP_PASSWORD="change-this-admin-password"

# Optional. Absolute admin session lifetime in seconds. Default: 28800 (8 hours)
# AUTH_SESSION_TTL_SECONDS="28800"

# Optional. Required to create/bootstrap an admin when NODE_ENV=production.
# ALLOW_ADMIN_CREATE_IN_PRODUCTION=""
